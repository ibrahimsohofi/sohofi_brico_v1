{
  "name": "sohofibrico-shop-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public e-commerce API for SohofiBrico, backed by the products_manager catalogue",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js up",
    "migrate:status": "node src/db/migrate.js status",
    "db:setup": "node scripts/00-setup-local-db.js",
    "seed:shop": "node scripts/run-all.js",
    "slugs": "node scripts/generate-slugs.js",
    "subcategories": "node scripts/seed-subcategories.js",
    "brands": "node scripts/normalize-brands.js",
    "images": "node scripts/backfill-images.js",
    "publish": "node scripts/apply-publish-rules.js",
    "shipping": "node scripts/seed-shipping.js",
    "lint": "biome check --write ."
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.4",
    "slugify": "^1.6.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "nodemon": "^3.1.7"
  }
}
